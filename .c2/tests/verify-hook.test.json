{
  "recipe": "../recipes/hooks/build/verify.yaml",
  "cases": [
    {
      "id": "standard-build-hook-inputs",
      "type": "integration_case",
      "runtime": {},
      "inputs": {
        "api_version": "c2.build-hook/v1",
        "request": "verify $(touch never-execute)",
        "target_directory": "; touch never-execute",
        "candidate": "candidate; $(touch never-execute)",
        "base": "base",
        "documents": {}
      },
      "mocks": {
        "ops": [
          {
            "match": {
              "node_path": "pulse-docker-verify/deterministic"
            },
            "behavior": {
              "mode": "return",
              "outputs": {
                "success": true,
                "exit_code": 0,
                "timed_out": false,
                "stdout": "Deterministic verification passed.",
                "error_message": ""
              }
            }
          }
        ]
      },
      "assertions": [
        {
          "type": "output_equals",
          "path": "api_version",
          "value": "c2.build-hook/v1"
        },
        {
          "type": "output_equals",
          "path": "status",
          "value": "passed"
        },
        {
          "type": "cel_true",
          "expr": "calls.size() == 1"
        },
        {
          "type": "op_input_equals",
          "node_path": "pulse-docker-verify/deterministic",
          "path": "run",
          "value": "./scripts/verify.sh"
        },
        {
          "type": "op_input_equals",
          "node_path": "pulse-docker-verify/deterministic",
          "path": "env.VERIFY_CANDIDATE",
          "value": "candidate; $(touch never-execute)"
        },
        {
          "type": "op_input_equals",
          "node_path": "pulse-docker-verify/deterministic",
          "path": "capture_diagnostics",
          "value": "always"
        }
      ]
    },
